{
  "expo": {
    "name": "collecta",
    "slug": "collecta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "collecta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6cbdd4c3-1bc6-4635-851b-e01ca160ac7e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.horbachevgen.collecta",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Collecta uses your location to show nearby finds on the map.",
        "NSPhotoLibraryUsageDescription": "Collecta needs access to your photos so you can attach preview images to the items in your collections."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D97706",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.horbachevgen.collecta",
      "blockedPermissions": ["android.permission.READ_MEDIA_VIDEO"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#D97706",
          "dark": {
            "backgroundColor": "#D97706"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Collecta uses your location to show nearby finds on the map."
        }
      ],
      "@journeyapps/react-native-quick-sqlite",
      "expo-localization",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "6cbdd4c3-1bc6-4635-851b-e01ca160ac7e"
      }
    },
    "owner": "horbachevgen"
  }
}
